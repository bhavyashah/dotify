# Copy this file to `.env` and fill in the values. `.env` is gitignored and must
# never be committed — it holds real secrets. This template lists only the
# variable NAMES so you know what to provide.
#
# The server reads .env as plain KEY=value lines (see loadEnv() in server.js).
# The server boots WITHOUT any key. Each keyed engine's key is checked only
# when a session starts, so you only need the key(s) for the engine(s) you
# intend to use. The Windows app's offline Nemotron model needs no key.

# OpenAI Realtime transcription (engine "openai").
# Only needed if you select the OpenAI engine in the UI.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AssemblyAI realtime transcription (engine "assemblyai").
# Only needed if you select the AssemblyAI engine in the UI.
# Get a key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Deepgram Nova-3 realtime transcription (engine "deepgram").
# Only needed if you select the Deepgram engine in the UI.
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ElevenLabs Scribe v2 Realtime transcription (engine "elevenlabs").
# Only needed if you select the ElevenLabs engine in the UI.
# Get a key at https://elevenlabs.io/ (the 11LABS_API_KEY spelling is also
# accepted and treated as this variable).
ELEVENLABS_API_KEY=
